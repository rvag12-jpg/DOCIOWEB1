# Desarrollo: simulación explícita; no hace solicitudes a OpenAI.
DOCIO_AI_PROVIDER=mock
OPENAI_API_KEY=replace_with_your_real_key
DOCIO_AI_MODEL=gpt-6-astra
DOCIO_AI_ACCESS_TOKEN=replace_with_a_random_access_token
